---
lang: en
title: hexagon.56k.guru
---

<!doctype html>
<html lang="{{ lang }}" data-theme="dark">
  <head>

    {% include "components/webpulse-analytics.njk" %}

    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark light">
    <link rel="canonical" href="{{ url | url(true) }}" />
    <link rel="alternate" type="application/rss+xml" title="Hexagon's Blog (RSS)" href="/feed.rss">
    <link rel="alternate" type="application/feed+json" title="Hexagon's Blog (JSON Feed)" href="/feed.json">

    <!-- Pico CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.min.css">

    <!-- Specific -->
    <title>{{ title }}</title>
 
    <link href="/css/style.css" rel="stylesheet" inline>
    <link href="/css/highlight.css" rel="stylesheet">

    <!-- Theme: dark unless the visitor picked light with the switcher -->
    <script>
      try {
        if (localStorage.getItem('preferredTheme') === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      } catch (_) { /* storage blocked: stay dark */ }

      document.addEventListener('DOMContentLoaded', () => {
        const html = document.documentElement;
        const switcher = document.getElementById('theme-switcher');
        const themeIcon = document.getElementById('theme-icon');

        const apply = (theme) => {
          html.setAttribute('data-theme', theme);
          switcher.setAttribute('data-theme', theme === 'dark' ? 'light' : 'dark');
          themeIcon.className = theme === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
        };
        apply(html.getAttribute('data-theme'));

        switcher.addEventListener('click', () => {
          const theme = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          apply(theme);
          try { localStorage.setItem('preferredTheme', theme); } catch (_) {}
        });
      });
    </script>

  </head>
  {{ content | safe }}
</html>
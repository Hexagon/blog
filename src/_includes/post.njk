---
layout: layout/body.njk
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ page.title | dump | safe }},
  "description": {{ ((page.intro if page.series else page.description) or page.intro or "") | dump | safe }},
  "url": {{ (url | url(true)) | dump | safe }},
  "mainEntityOfPage": {{ (url | url(true)) | dump | safe }},
  "datePublished": "{{ page.date | date('ISO') }}",
  "dateModified": "{{ (page.updated or page.date) | date('ISO') }}",
  {% if page.metas and page.metas.image %}"image": {{ page.metas.image | dump | safe }},{% endif %}
  "keywords": "{% for t in page.tags %}{% if t not in ["standalone", "post", "index"] %}{{ t }},{% endif %}{% endfor %}",
  "author": {
    "@type": "Person",
    "name": "Hexagon",
    "url": "https://hexagon.56k.guru"
  },
  "publisher": {
    "@type": "Person",
    "name": "Hexagon",
    "url": "https://hexagon.56k.guru"
  }
}
</script>
{% if extra == "multi-pointer" %}
  {% include "partials/multi-pointer.njk" %}
{% endif %}

<div class="grid">
  <section>
    <div>
      {% include "partials/post-details.njk" %}
      {{ intro | md | safe }}
      <br>
      {% include "partials/toc.njk" %}
      {{ content | safe }}    
      {% include "partials/share.njk" %}
      <hr>
      {% include "partials/next-previous.njk" %}
    </div>
  </section>
  <!-- Sidebar -->
  <aside>
    {% include "components/search.njk" %}
    {% include "partials/series-toc.njk" %}
    {% include "partials/more-series.njk" %}
    {% include "partials/recommended.njk" %}
  </aside>
</div>
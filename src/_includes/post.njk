---
layout: layout/body.njk
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ page.data.title | dump | safe }},
  "description": {{ ((page.data.intro if page.data.series else page.data.description) or page.data.intro or "") | dump | safe }},
  "url": {{ (page.data.url | url(true)) | dump | safe }},
  "mainEntityOfPage": {{ (page.data.url | url(true)) | dump | safe }},
  "datePublished": "{{ page.data.date | date("yyyy-MM-dd'T'HH:mm:ssXXX") }}",
  "dateModified": "{{ (page.data.updated or page.data.date) | date("yyyy-MM-dd'T'HH:mm:ssXXX") }}",
  {% if page.data.metas and page.data.metas.image %}"image": {{ page.data.metas.image | dump | safe }},{% endif %}
  "keywords": "{% for t in page.data.tags %}{% if t not in ["standalone", "post", "index"] %}{{ t }},{% endif %}{% endfor %}",
  "author": {
    "@type": "Person",
    "name": "Hexagon",
    "url": "https://hexagon.56k.guru"
  },
  "publisher": {
    "@type": "Person",
    "name": "Hexagon",
    "url": "https://hexagon.56k.guru"
  }
}
</script>
{% if extra == "multi-pointer" %}
  {% include "partials/multi-pointer.njk" %}
{% endif %}

<div class="grid">
  <section>
    <div>
      {% include "partials/post-details.njk" %}
      {{ intro | md | safe }}
      <br>
      {% include "partials/toc.njk" %}
      {{ content | safe }}    
      {% include "partials/share.njk" %}
      <hr>
      {% include "partials/next-previous.njk" %}
    </div>
  </section>
  <!-- Sidebar -->
  <aside>
    {% include "components/search.njk" %}
    {% include "partials/series-toc.njk" %}
    {% include "partials/more-series.njk" %}
    {% include "partials/recommended.njk" %}
  </aside>
</div>
{% set shareUrl = page.data.url | url(true) %}
{% set u = shareUrl | urlencode %}
{% set t = page.data.title | urlencode %}
<div class="share" aria-label="Share this post">
  <span class="share-prompt">$ share</span>
  <button type="button" class="share-native" data-url="{{ shareUrl }}" data-title="{{ page.data.title }}" title="Share or copy link"><i class="fas fa-share-nodes"></i> <span>share</span></button>
  <a href="https://news.ycombinator.com/submitlink?u={{ u }}&amp;t={{ t }}" target="_blank" rel="noopener" title="Submit to Hacker News"><i class="fab fa-hacker-news"></i> hn</a>
  <a href="https://www.reddit.com/submit?url={{ u }}&amp;title={{ t }}" target="_blank" rel="noopener" title="Share on Reddit"><i class="fab fa-reddit-alien"></i> reddit</a>
  <a href="https://bsky.app/intent/compose?text={{ t }}%20{{ u }}" target="_blank" rel="noopener" title="Share on Bluesky"><i class="fas fa-cloud"></i> bsky</a>
  <a href="https://mastodonshare.com/?text={{ t }}&amp;url={{ u }}" target="_blank" rel="noopener" title="Share on Mastodon"><i class="fab fa-mastodon"></i> mastodon</a>
  <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ u }}" target="_blank" rel="noopener" title="Share on LinkedIn"><i class="fab fa-linkedin"></i> linkedin</a>
  <a href="https://x.com/intent/post?text={{ t }}&amp;url={{ u }}" target="_blank" rel="noopener" title="Share on X"><i class="fab fa-x-twitter"></i> x</a>
</div>
<script>
  document.querySelectorAll(".share-native").forEach((btn) => {
    const label = btn.querySelector("span");
    if (!navigator.share) label.textContent = "copy link";
    btn.addEventListener("click", async () => {
      const { url, title } = btn.dataset;
      if (navigator.share) {
        try { await navigator.share({ title, url }); } catch (_) { /* cancelled */ }
        return;
      }
      try {
        await navigator.clipboard.writeText(url);
        label.textContent = "copied ✓";
      } catch (_) {
        prompt("Copy this link:", url);
      }
      setTimeout(() => (label.textContent = "copy link"), 2000);
    });
  });
</script>

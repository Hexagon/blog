{% if page.header %}
  <img src="{{ page.header }}" class="header-image" alt="{{ page.title }}">
{% endif %}
<hgroup class="post-header">
  <h1><a href="{{ page.url }}" class="link-secondary">{{page.title}}</a></h1>
  <p>
    {% if page.author %}
        by <strong>{{ page.author.name }}</strong>, 
    {% endif %}

    <!-- Date -->
    <time class="mb-1" datetime="{{ page.date | date('ISO') }}">
        {{ page.date | date }}</time>{% if page.updated %}<span>, Updated:</span>
      <time class="mb-1" datetime="{{ page.updated | date('ISO') }}">
        {{ page.updated | date }}
      </time>
    {% endif %}
    
    <!-- Reading time -->
    <span class="badge badge-alt">{{ page.reading.minutes }} min read</span>

    <!-- License -->
    <!--
    {% if page.license %}
      <span class="badge text-bg-success">{{ page.license }}</span>
    {% endif %}
    -->
    
    <!-- Tags -->
    {% for tag in tags %}
      {% if tag not in ["standalone","index","post"] and not (series and tag == series.tag) %}
        <a href="/archive/{{ tag }}"><span class="badge tag">{{tag}}</span></a>
      {% endif %}
    {% endfor %}
  </p>
</hgroup>
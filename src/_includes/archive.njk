---
layout: page.njk
title: Hexagon's Blog - Archive
---

<section>

    {% if tag %}
        <hgroup>
            <h1>Archive - Tagged with '{{ tag }}'</h1>
            <p><a href="/archive/">&lt; Back</a></p>
        </hgroup>
    {% else %}
        <h1>Archive</h1>
    {% endif %}

    <hr />

    <!-- List of tags -->
    {% if allTags.length > 0 %}
        {% for t in allTags %}  
            <a href="/archive/{{ t }}/" class="badge">{{ t }}</a> 
        {% endfor %}
        <hr />
    {% endif %}
    
    <br />

    <!-- List of posts -->
    <div class="post-list">
    {% for post in articles %}  
        <section>
            <hgroup>
                <h2 class="post-title"><a href="{{ post.url }}" class="link-secondary">{{post.title | title }}</a></h2>
                <p>
                    <!-- Author -->
                    {% if post.author %}
                        by <strong>{{ post.author.name }}</strong>, 
                    {% endif %}

                    <!-- Date -->
                    <time class="mb-1" datetime="{{ post.date | date("yyyy-MM-dd'T'HH:mm:ss'.000'XX") }}">
                        {{ post.date | date }}</time>{% if post.updated %}<span>, Updated:</span>
                    <time class="mb-1" datetime="{{ post.updated | date("yyyy-MM-dd'T'HH:mm:ss'.000'XX") }}">
                        {{ post.updated | date }}
                    </time>
                    {% endif %}
                </p>
            </hgroup>
            <p>
                {{ post.intro | md | safe }}
            </p>
        </section>
    {% endfor %}
    </div>
</section>
---
layout: page.njk
---

<section>

    {% if term %}
        <hgroup>
            <h1 class="hello">archive <span class="tag-filter">#{{ term }}</span></h1>
            <p class="cd-back"><a href="/archive/">cd ..</a></p>
        </hgroup>
    {% else %}
        <h1 class="hello">archive</h1>
    {% endif %}

    <hr />

    <!-- List of tags -->
    {% if not term and terms %}
        {% for t in terms %}  
            <a href="{{ t.url }}" class="badge">{{ t.name }}</a> 
        {% endfor %}
        <hr />
    {% endif %}
    
    <br />

    <!-- List of posts -->
    <div class="post-list">
    {% for post in search.pages(query, "date=desc") %}  
        <section>
            <hgroup>
                <h2 class="post-title"><a href="{{ post.url }}" class="link-secondary">{{ post.title }}</a></h2>
                <p>
                    <!-- Author -->
                    {% if post.author %}
                        by <strong>{{ post.author.name }}</strong>, 
                    {% endif %}

                    <!-- Date -->
                    <time class="mb-1" datetime="{{ post.date | date('ISO') }}">
                        {{ post.date | date }}</time>{% if post.updated %}<span>, Updated:</span>
                    <time class="mb-1" datetime="{{ post.updated | date('ISO') }}">
                        {{ post.updated | date }}
                    </time>
                    {% endif %}
                </p>
            </hgroup>
            <p>
                {{ post.intro | md | safe }}
            </p>
        </section>
    {% endfor %}
    </div>
</section>